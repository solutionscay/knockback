# Copy to .env next to docker-compose.yml and edit. Read by docker compose and deploy/*.sh.

# Public hostname. A real DNS name pointing at the VM gets a Let's Encrypt certificate.
# "localhost" = local test with Caddy's own CA.
KB_DOMAIN=localhost

# Published ports (80/443 on the VM; e.g. 8080/8443 for a local test).
KB_HTTP_PORT=80
KB_HTTPS_PORT=443

# Image tag to run. deploy/deploy.sh sets this (git short hash); "local" = built by `docker compose up --build`.
KB_IMAGE_TAG=local

# Match server settings (see scripts/match-server.ts).
KB_DEADLINE=20        # seconds an agent has to plan a round
KB_FILL_AFTER=60      # seconds an open match waits before house bots fill empty seats
KB_OPEN=false         # true = no seat-token checks (trusted LAN only, never on the internet)
KB_NO_MATCH=true      # false = create one open match at startup

# MCP lobby (#21): agents join through https://<domain>/mcp; join_lobby seats them in lobby matches.
KB_LOBBY_SEATS=remote,remote,remote,house   # seats of a new lobby match
KB_MCP_DEADLINE=75    # seconds an MCP agent has to plan a round (60-90 suits full agents)
KB_LOBBY_FILL=120     # seconds before house bots fill a lobby match's empty seats
KB_PUBLIC_URL=        # e.g. https://kb.example.com (links in tool results); empty = from the request
KB_FAST=false         # false = matches run at broadcast speed (#22); true = instant rounds
KB_CHECKINS=true   # mid-round check-ins (#9); false turns them off

# Backups (deploy/backup.sh).
KB_BACKUP_DIR=./backups
KB_BACKUP_KEEP_DAYS=14
# Off-VM copy: an rsync destination (user@backup-host:/path/knockback/) or empty for none.
KB_BACKUP_REMOTE=
